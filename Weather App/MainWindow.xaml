<Window x:Class="Weather_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:vm="clr-namespace:Weather_App.ViewModels"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Weather_App"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="380">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--Search-->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="4" Grid.Row="0" >
            <TextBox Grid.Row="0" Grid.ColumnSpan="3" x:Name="searchCityTextBox" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Row="4" Grid.Column="4" x:Name="aplyBtn" Command="{Binding SearchCommand}">
                <Image Source="pack://application:,,,/Assets/search.png" Stretch="Uniform"/>
            </Button>
        </StackPanel>
        <!--Main temp-->
        <StackPanel Margin="0 -30 0 10" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Grid.RowSpan="2">
            <Image x:Name="MainTemperatureImg" Grid.Row="1" Style="{StaticResource MainWeatherImg}" Source="pack://application:,,,/Assets/clear.png"/>
            <TextBlock  Text="{Binding CityName}"/>
            <TextBlock  Text="{Binding CountryName}"/>
            <TextBlock Text="{Binding Temperature}"/>
        </StackPanel>
            <!-- Hum Info-->
        <WrapPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4">
            <Image Source="/Assets/humidity.png"/>
            <StackPanel>
                <TextBlock  Text="{Binding Humidity}"/>
                <Label Content="humidity"/>
            </StackPanel>
        </WrapPanel>
        
        <!--Wind Info-->
        <WrapPanel Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="4">
            <Image Source="/Assets/wind.png"/>
            <StackPanel>
                <TextBlock Text="{Binding WindSpeed}"/>
                <Label Content="wind speed"/>
            </StackPanel>
        </WrapPanel>
    </Grid>
</Window>
